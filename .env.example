# Copia questo file in .env.local e inserisci i valori del tuo progetto Supabase
# (Supabase -> Project Settings -> API). La chiave publishable e' pubblica; NON mettere mai qui la secret/service_role key.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SHOW_DEMO=false
